{
  "name": "verid-digital-product-passport",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"@workspace/*\" --parallel run dev",
    "dev:all": "concurrently -k -n \"AI,API,WEB\" -c \"magenta.bold,cyan.bold,green.bold\" \"pnpm dev:ai\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "start:all": "pnpm dev:all",
    "dev:web": "pnpm --filter @workspace/digital-product-passport run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:ai": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir apps/ai-service",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:ai": "python apps/ai-service/test_ai.py",
    "test:suite": "python tests/test_api_suite.py",
    "eval:model": "python Model/evaluate_model.py",
    "start": "pnpm --filter @workspace/api-server run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
